{
 "uid": "golden",
 "title": "Golden Signals y SLO — multi-nube",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "lab-e2e"
 ],
 "panels": [
  {
   "id": 1,
   "title": "Tráfico por servicio (req/s) — GCP y AWS",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sli:requests:rate1m",
     "legendFormat": "{{service_name}} ({{cloud_provider}})",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 2,
   "title": "Error ratio vs banda dinámica (baseline + 2σ)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sli:error_ratio:rate1m{service_name=\"service-a\"}",
     "legendFormat": "error ratio service-a",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "aiops:error_ratio:band_upper{service_name=\"service-a\"}",
     "legendFormat": "banda superior",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "sli:error_ratio:rate1m{service_name=\"data-service\"}",
     "legendFormat": "error ratio data-service",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 3,
   "title": "Latencia p99 vs SLO (300 ms) y banda",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sli:latency_p99:1m",
     "legendFormat": "p99 {{service_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "aiops:latency_p99:band_upper{service_name=\"service-a\"}",
     "legendFormat": "banda superior service-a",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      },
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 4,
   "title": "SLI disponibilidad service-a (objetivo 99,5 %)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - sli:error_ratio:rate1m{service_name=\"service-a\"}",
     "legendFormat": "disponibilidad",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.995
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 5,
   "title": "SLI latencia: % requests < 300 ms (objetivo 99 %)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sli:latency_good_ratio:rate1m{service_name=\"service-a\"}",
     "legendFormat": "good ratio",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 6,
   "title": "Error budget consumido (última hora, sobre presupuesto de 28 días)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(sum_over_time(slo:bad_availability:increase1m{service_name=\"service-a\"}[1h])) / (0.005 * avg(sli:requests:rate1m{service_name=\"service-a\"}) * 2419200)",
     "legendFormat": "disponibilidad",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum(sum_over_time(slo:bad_latency:increase1m{service_name=\"service-a\"}[1h])) / (0.01 * avg(sli:requests:rate1m{service_name=\"service-a\"}) * 2419200)",
     "legendFormat": "latencia",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 7,
   "title": "Alertas activas por pipeline",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count by (pipeline) (ALERTS{alertstate=\"firing\"})",
     "legendFormat": "{{pipeline}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "title": "Service mesh L7 — respuestas por clase (Envoy)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mesh_workload, envoy_response_code_class) (rate(envoy_http_downstream_rq_xx{envoy_http_conn_manager_prefix=\"ingress\"}[1m]))",
     "legendFormat": "{{mesh_workload}} {{envoy_response_code_class}}xx",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 9,
   "title": "Grafo de servicios (servicegraph): p99 por arista",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (client, server, le) (rate(traces_service_graph_request_server_seconds_bucket[1m])))",
     "legendFormat": "{{client}} → {{server}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 10,
   "title": "Spans de BD (OTel DB semconv) — p99 por sistema",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le, db_system_name) (rate(traces_span_metrics_duration_seconds_bucket{service_name=\"data-service\", db_system_name!=\"\"}[1m])))",
     "legendFormat": "{{db_system_name}} p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 11,
   "title": "Notificaciones recibidas: estático vs AIOps",
   "type": "barchart",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pipeline) (increase(aiops_notifications_total{status=\"firing\"}[30m]))",
     "legendFormat": "{{pipeline}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 12,
   "title": "Logs de error correlacionados (Loki → trace_id)",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service_name=~\"service-a|service-b|data-service\"} |~ \"(?i)error|timeout\"",
     "legendFormat": "",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true
   }
  }
 ],
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "name": "Caos / ruido",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "max by (kind) (lab_fault_active{kind=\"chaos_error_rate\"} > 0)",
    "step": "15s",
    "titleFormat": "Caos activo"
   }
  ]
 }
}