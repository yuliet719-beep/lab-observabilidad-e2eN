{
  "displayName": "Golden Signals de Seguridad (LAB e2e)",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      { "width": 6, "height": 4, "widget": { "title": "Intentos de autenticación fallidos /min",
        "xyChart": { "dataSets": [{ "timeSeriesQuery": { "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/security/auth_failures\"",
          "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" } } } }] } } },
      { "xPos": 6, "width": 6, "height": 4, "widget": { "title": "Conexiones denegadas por firewall (por puerto)",
        "xyChart": { "dataSets": [{ "timeSeriesQuery": { "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/network/firewall_denied\"",
          "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.dest_port"] } } } }] } } },
      { "yPos": 4, "width": 6, "height": 4, "widget": { "title": "Tráfico N-S vs E-W (bytes, VPC Flow Logs)",
        "xyChart": { "dataSets": [{ "timeSeriesQuery": { "prometheusQuery": "sum by (direction) (rate(vpc_flow_bytes_total[5m]))" } }] } } },
      { "xPos": 6, "yPos": 4, "width": 6, "height": 4, "widget": { "title": "CVEs activos por severidad",
        "xyChart": { "dataSets": [{ "timeSeriesQuery": { "prometheusQuery": "sum by (severity) (security_cves_active)" } }] } } },
      { "yPos": 8, "width": 12, "height": 4, "widget": { "title": "Flujos no permitidos hacia Cloud SQL",
        "xyChart": { "dataSets": [{ "timeSeriesQuery": { "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/network/unexpected_db_flows\"",
          "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" } } } }] } } }
    ]
  }
}
